<baram-os-config>
    <display>
        <pointer>
            <size>10</size>
        </pointer>
        <wallpaper>
            <file>baram.png</file>
            <color />
            <mode>file</mode>
        </wallpaper>
        <hud>
            <enabled>1</enabled>
        </hud>
        <gpu>
            <enabled>1</enabled>
        </gpu>
    </display>
    <ui-theme>
        <color>
            <bg>F0F0F0</bg>
            <panel>FFFFFF</panel>
            <text>1A1A1A</text>
            <muted>666666</muted>
            <border>D0D0D0</border>
            <taskbar>F5F5F5</taskbar>
            <win_bg>F3F3F3</win_bg>
            <win_inactive>E8E8E8</win_inactive>
            <card_bg>F5F5F5</card_bg>
            <btn_bg>D8D8D8</btn_bg>
            <btn_primary>0A60FF</btn_primary>
            <btn_tonal>E6E6E6</btn_tonal>
            <btn_tonal_hover>D2D2D2</btn_tonal_hover>
            <btn_text>FFFFFF</btn_text>
            <switch_on>0A60FF</switch_on>
            <switch_off>DDDDDD</switch_off>
        </color>
        <window>
            <title_bar_h>40</title_bar_h>
            <min_win_w>120</min_win_w>
            <min_win_h>60</min_win_h>
            <win_radius>20</win_radius>
            <shadow_pad>30</shadow_pad>
            <scroll_speed>15</scroll_speed>
        </window>
        <button>
            <size>20</size>
            <radius>8</radius>
            <corner>20</corner>
        </button>
        <card>
            <radius>20</radius>
        </card>
        <taskbar>
            <h>48</h>
        </taskbar>
        <cursor>
            <w>15</w>
            <h>19</h>
            <size_w>19</size_w>
            <size_h>19</size_h>
            <shadow_blur>12</shadow_blur>
            <shadow_x>3</shadow_x>
            <shadow_y>4</shadow_y>
        </cursor>
        <switch>
            <w>22</w>
            <h>22</h>
            <radius>8</radius>
        </switch>
    </ui-theme>
    <keyboard>
        <shift_key>0</shift_key>
    </keyboard>
    <mouse>
        <speed>6.0</speed>
    </mouse>
    <trackpad>
        <speed>3.0</speed>
    </trackpad>
    <system>
        <done>1</done>
        <timezone>+09:00</timezone>
        <reset>
            <option />
        </reset>
    </system>
</baram-os-config>
