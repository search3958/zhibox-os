#!/bin/busybox sh
/bin/busybox --install -s
mount -t proc     proc     /proc  2>/dev/null
mount -t sysfs    sysfs    /sys   2>/dev/null
mount -t devtmpfs devtmpfs /dev   2>/dev/null
mount -t tmpfs    tmpfs    /tmp   2>/dev/null

# ---------------------------------------------------------------- HTML (guest WebKitGTK)
# QEMU の IDE ディスクとして渡された rootfs.img を読み取り専用でマウントし、
# chroot 内で Xvfb + WebKitGTK を実行する。GUI 起動時はレンダラを常駐させ、
# fb-gradient が /tmp/html.input に書くポインタ位置を XTEST で WebKit に送る。
# これにより CSS :hover がリアルタイムに反映される。
GUEST_ROOT=/mnt/root
GUEST_PID=""
GRADIENT_PID=""
WARP4_PID=""
DESKTOP_PID=""
GUEST_MOUNTED=0

guest_mount() {
	[ "$GUEST_MOUNTED" = 1 ] && return 0

	for dev in /dev/sda /dev/sda1 /dev/sdb /dev/sdb1 /dev/vda /dev/vda1; do
		[ -b "$dev" ] || continue

		mkdir -p "$GUEST_ROOT"
		if ! mount -t ext4 -o ro "$dev" "$GUEST_ROOT" 2>/dev/null; then
			continue
		fi
		if [ ! -x "$GUEST_ROOT/opt/zhibox/launch.sh" ]; then
			umount "$GUEST_ROOT" 2>/dev/null
			continue
		fi

		echo "guest html: rootfs $dev"
		mkdir -p "$GUEST_ROOT/proc" "$GUEST_ROOT/sys" \
			 "$GUEST_ROOT/dev" "$GUEST_ROOT/tmp" \
			 "$GUEST_ROOT/run" "$GUEST_ROOT/out" \
			 "$GUEST_ROOT/dev/pts" "$GUEST_ROOT/dev/shm" \
			 2>/dev/null
		mount -t proc  proc  "$GUEST_ROOT/proc" 2>/dev/null
		mount -t sysfs sysfs "$GUEST_ROOT/sys"  2>/dev/null
		mount -o bind /dev "$GUEST_ROOT/dev" 2>/dev/null
		mount -t devpts devpts "$GUEST_ROOT/dev/pts" 2>/dev/null
		mount -t tmpfs tmpfs "$GUEST_ROOT/dev/shm" 2>/dev/null
		mount -t tmpfs tmpfs "$GUEST_ROOT/tmp" 2>/dev/null
		mount -t tmpfs tmpfs "$GUEST_ROOT/run" 2>/dev/null
		chmod 1777 "$GUEST_ROOT/tmp" "$GUEST_ROOT/dev/shm" 2>/dev/null
		mount -o bind /tmp "$GUEST_ROOT/out" 2>/dev/null

		GUEST_MOUNTED=1
		return 0
	done

	return 1
}

guest_umount() {
	[ "$GUEST_MOUNTED" = 1 ] || return 0

	umount "$GUEST_ROOT/out" 2>/dev/null
	umount "$GUEST_ROOT/dev/shm" 2>/dev/null
	umount "$GUEST_ROOT/dev/pts" 2>/dev/null
	umount "$GUEST_ROOT/dev" 2>/dev/null
	umount "$GUEST_ROOT/proc" 2>/dev/null
	umount "$GUEST_ROOT/sys" 2>/dev/null
	umount "$GUEST_ROOT/tmp" 2>/dev/null
	umount "$GUEST_ROOT/run" 2>/dev/null
	umount "$GUEST_ROOT" 2>/dev/null
	GUEST_MOUNTED=0
}

# シリアル検証用: 1 枚描画して終了する。
render_guest_html() {
	rm -f /tmp/html.raw /tmp/html.input /tmp/html.version /tmp/html.stop
	if ! guest_mount; then
		echo "guest html: rootfs disk not attached (WEBKIT placeholder)"
		return 1
	fi

	chroot "$GUEST_ROOT" /opt/zhibox/launch.sh /out/html.raw
	rc=$?
	echo "guest html: render rc=$rc"

	guest_umount

	if [ "$rc" -eq 0 ] && [ -s /tmp/html.raw ]; then
		echo "guest html: /tmp/html.raw ready"
		return 0
	fi
	rm -f /tmp/html.raw
	return 1
}

# GUI 用: レンダラを常駐させ、最初のフレームができたら戻る。
start_guest_html_live() {
	rm -f /tmp/html.raw /tmp/html.input /tmp/html.version /tmp/html.stop
	if ! guest_mount; then
		echo "guest html: rootfs disk not attached (WEBKIT placeholder)"
		return 1
	fi

	echo "guest html: live renderer starting"
	ZH_HTML_LIVE=1 chroot "$GUEST_ROOT" \
		/opt/zhibox/launch.sh /out/html.raw &
	GUEST_PID=$!

	i=0
	while [ "$i" -lt 1200 ]; do
		[ -s /tmp/html.raw ] && break
		kill -0 "$GUEST_PID" 2>/dev/null || break
		i=$((i + 1))
		sleep 0.1
	done

	if [ -s /tmp/html.raw ]; then
		echo "guest html: live ready (pid $GUEST_PID)"
		return 0
	fi

	echo "guest html: live render failed"
	touch /tmp/html.stop 2>/dev/null
	wait "$GUEST_PID" 2>/dev/null
	GUEST_PID=""
	guest_umount
	return 1
}

stop_guest_html_live() {
	touch /tmp/html.stop 2>/dev/null

	if [ -n "$GUEST_PID" ]; then
		i=0
		while kill -0 "$GUEST_PID" 2>/dev/null && [ "$i" -lt 100 ]; do
			i=$((i + 1))
			sleep 0.1
		done
		if kill -0 "$GUEST_PID" 2>/dev/null; then
			kill "$GUEST_PID" 2>/dev/null
		fi
		wait "$GUEST_PID" 2>/dev/null
		GUEST_PID=""
	fi

	rm -f /tmp/html.stop /tmp/html.input
	guest_umount
}

# GUI: native Warp 4 runner.  It publishes RGBA frames to /tmp/warp4.raw and
# receives pointer/button state from fb-gradient through /tmp/warp4.input.
start_warp4() {
	[ -x /bin/warp4 ] || {
		echo "warp4: runner not present (WARP4 placeholder)"
		return 1
	}

	rm -f /tmp/warp4.raw /tmp/warp4.version /tmp/warp4.input /tmp/warp4.stop
	echo 3 > /proc/sys/kernel/printk 2>/dev/null
	echo "warp4: starting native app (calc.w4a)"
	BARAM_ROOT=/usr/share/zhibox /bin/warp4 calc.w4a &
	WARP4_PID=$!

	i=0
	while [ "$i" -lt 300 ]; do
		[ -s /tmp/warp4.raw ] && break
		kill -0 "$WARP4_PID" 2>/dev/null || break
		i=$((i + 1))
		sleep 0.05
	done

	if [ -s /tmp/warp4.raw ]; then
		echo "warp4: live ready (pid $WARP4_PID)"
		return 0
	fi

	echo "warp4: live render failed"
	touch /tmp/warp4.stop 2>/dev/null
	wait "$WARP4_PID" 2>/dev/null
	WARP4_PID=""
	return 1
}

stop_warp4() {
	touch /tmp/warp4.stop 2>/dev/null

	if [ -n "$WARP4_PID" ]; then
		i=0
		while kill -0 "$WARP4_PID" 2>/dev/null && [ "$i" -lt 50 ]; do
			i=$((i + 1))
			sleep 0.05
		done
		if kill -0 "$WARP4_PID" 2>/dev/null; then
			kill "$WARP4_PID" 2>/dev/null
		fi
		wait "$WARP4_PID" 2>/dev/null
		WARP4_PID=""
	fi

	rm -f /tmp/warp4.stop /tmp/warp4.input
}


# GUI: full BaramOS desktop.  This owns /dev/fb0 and evdev directly; the
# compositor, window manager, IME, launcher, taskbar, Warp 3/4 engines and
# SVG cursor are all inside the single /bin/desktop binary.
start_desktop() {
	[ -x /bin/desktop ] || {
		echo "desktop: /bin/desktop not present"
		return 1
	}

	# Optional one-shot URI supplied by the QEMU command line, e.g.
	#   zh_uri=os://display/gpu?enabled=0
	zh_uri=""
	for arg in $(cat /proc/cmdline 2>/dev/null); do
		case "$arg" in
			zh_uri=*) zh_uri="${arg#zh_uri=}" ;;
		esac
	done
	[ -n "$zh_uri" ] && printf '%s\n' "$zh_uri" > /tmp/zhibox.uri

	# The framebuffer console keeps printing kernel messages on top of the
	# desktop (e.g. the slow TCG "random: crng init done").  Drop the console
	# log level before the compositor takes over; real errors still show.
	echo 3 > /proc/sys/kernel/printk 2>/dev/null

	echo "desktop: starting BaramOS GUI (native compositor)"
	BARAM_ROOT=/usr/share/zhibox /bin/desktop &
	DESKTOP_PID=$!

	# The binary logs to the serial console.  Keep the shell waiting here so
	# the guest does not fall through to an interactive prompt underneath the
	# framebuffer desktop.
	wait "$DESKTOP_PID" 2>/dev/null
	DESKTOP_PID=""
	echo "desktop: exited"
}

# GUI: gradient を先に起動し、最初のフレームが出たことを /tmp/gradient.ready
# で確認してから WebKitGTK レンダラを起動する。
start_gradient_and_html() {
	GRADIENT_PID=""

	rm -f /tmp/gradient.ready
	echo "gradient: starting (guest WebKit follows)"
	/bin/gradient &
	GRADIENT_PID=$!

	i=0
	while [ "$i" -lt 300 ]; do
		[ -s /tmp/gradient.ready ] && break
		kill -0 "$GRADIENT_PID" 2>/dev/null || break
		i=$((i + 1))
		sleep 0.1
	done

	if [ -s /tmp/gradient.ready ]; then
		echo "gradient: ready -> starting native Warp4"
		start_warp4 || true
		echo "gradient: ready -> starting guest WebKit"
		start_guest_html_live || true
	else
		echo "gradient: ready timeout (guest renderers not started)"
	fi

	wait "$GRADIENT_PID" 2>/dev/null
	GRADIENT_PID=""
	echo "gradient: exited"
	stop_warp4
	stop_guest_html_live
	rm -f /tmp/gradient.ready
}

echo
echo "=============================================="
echo "  openEuler kernel boot test"
echo "=============================================="
uname -a
echo
echo "ZHIBOX_BOOT_OK"
[ -x /bin/gradient ] && echo "Type 'gradient' to switch to the video mode."
echo "=============================================="
if grep -q boottest /proc/cmdline 2>/dev/null; then
  echo "(boot test mode -> poweroff)"
  poweroff -f
  sleep 5
  halt -f
fi

if grep -q zh_gui /proc/cmdline 2>/dev/null && [ -x /bin/desktop ]; then
	start_desktop || true
elif grep -q zh_gui /proc/cmdline 2>/dev/null && [ -x /bin/gradient ]; then
	echo "(fallback framebuffer demo: drag a title bar with the mouse, q to quit)"
	start_gradient_and_html
elif grep -q zh_html_root /proc/cmdline 2>/dev/null; then
	render_guest_html || true
fi

exec /bin/sh
